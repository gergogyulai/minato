# Minato — Production Environment
# Copy to .env alongside docker-compose.yaml, fill in the values, then:
#   docker compose up -d

# ── Required ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Choose a strong password for the internal Postgres database
POSTGRES_PASSWORD=
# Generate with: openssl rand -hex 32
MEILISEARCH_MASTER_KEY=
# TMDB Read Access Token — https://developer.themoviedb.org/docs/getting-started
TMDB_READ_ACCESS_TOKEN=

# ── Optional ──────────────────────────────────────────────────────────────────
# Passkey (WebAuthn) support — set to your deployment's public hostname
# Without this, passkeys are disabled. Example: minato.example.com
# PASSKEY_RP_ID=
# AI-powered metadata repair — only needed if you enable this feature in settings
# OPENROUTER_API_KEY=

