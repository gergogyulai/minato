{
	"name": "@project-minato/api",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --watch src/index.ts",
		"start": "bun run dist/index.mjs"
	},
	"exports": {
		"./routers": "./src/api/app.ts"
	},
	"dependencies": {
		"@hono/zod-validator": "^0.8.0",
		"@orpc/client": "catalog:",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"@project-minato/auth": "workspace:*",
		"@project-minato/config": "workspace:*",
		"@project-minato/db": "workspace:*",
		"@project-minato/env": "workspace:*",
		"@project-minato/meilisearch": "workspace:*",
		"@project-minato/queue": "workspace:*",
		"@project-minato/utils": "workspace:*",
		"@scalar/hono-api-reference": "^0.11.4",
		"better-auth": "catalog:",
		"cron-parser": "catalog:",
		"drizzle-orm": "catalog:",
		"fast-xml-parser": "^5.9.3",
		"hono": "^4.12.26",
		"xmlbuilder2": "^4.0.3",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@project-minato/typescript": "workspace:*",
		"@types/bun": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:"
	}
}
