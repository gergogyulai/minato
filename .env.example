# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of your deployment (used for auth redirects)
# BETTER_AUTH_URL=https://minato.example.com
# Allowed CORS origin if frontend is on a different domain
# CORS_ORIGIN=https://minato.example.com

DATABASE_URL=postgresql://postgres:password@localhost:5432/project-minato
REDIS_URL=redis://localhost:6379

MEILISEARCH_HOST=http://localhost:7700
# Generate with: openssl rand -hex 32
MEILISEARCH_MASTER_KEY=

# TMDB Read Access Token — https://developer.themoviedb.org/docs/getting-started
TMDB_READ_ACCESS_TOKEN=

# Optional — used by AI repair features
# OPENROUTER_API_KEY=

MINATO_SEARCH_ENGINE_PROFILE=freshness

# Frontend dev server URL (web app only)
VITE_SERVER_URL=http://localhost:3000

NODE_ENV=development
