# Minato — Development Environment
# Copy to .env and fill in the required values, then start infra: docker compose -f docker-compose.dev.yaml up -d

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/project-minato
# Defaults to redis://redis:6379 — override for local dev
REDIS_URL=redis://localhost:6379

# ── Search ────────────────────────────────────────────────────────────────────
# Defaults to http://meilisearch:7700 — override for local dev
MEILISEARCH_HOST=http://localhost:7700
# Generate with: openssl rand -hex 32
MEILISEARCH_MASTER_KEY=masterKey_change_me_in_production

# ── External APIs ─────────────────────────────────────────────────────────────
# TMDB Read Access Token — https://developer.themoviedb.org/docs/getting-started
TMDB_READ_ACCESS_TOKEN=
# OpenRouter — optional, only needed for AI repair features
# OPENROUTER_API_KEY=

# ── Prowlarr proxy ────────────────────────────────────────────────────────────
# Point Sonarr/Radarr at /api/v1/proxy/prowlarr instead of Prowlarr directly.
# PROWLARR_URL=http://localhost:9696/
# PROWLARR_API_KEY=                      # Prowlarr API key — enforced if set

# ── Dev only ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# Frontend dev proxy — defaults to http://localhost:3000 if unset
# VITE_SERVER_URL=http://localhost:3000
