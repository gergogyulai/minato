{
	"name": "project-minato",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"apps/scraper/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.2.2",
			"zod": "^4.3.6",
			"typescript": "^6.0.3",
			"@types/bun": "^1.3.14",
			"better-auth": "^1.6.20",
			"@better-auth/drizzle-adapter": "^1.6.20",
			"@better-auth/api-key": "^1.6.20",
			"drizzle-orm": "^0.45.2",
			"bullmq": "^5.79.1",
			"defu": "^6.1.7",
			"ioredis": "5.11.1",
			"@orpc/server": "^1.14.6",
			"@orpc/openapi": "^1.14.6",
			"@orpc/zod": "^1.14.6",
			"@orpc/client": "^1.14.6",
			"@orpc/tanstack-query": "^1.14.6",
			"cron-parser": "^5.6.0",
			"tsdown": "^0.22.3",
			"dot-prop": "^10.1.0"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo dev db:studio && bun run infra:up",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"dev:native": "turbo -F native dev",
		"dev:web": "turbo -F web dev",
		"dev:server": "turbo -F server dev",
		"db:push": "turbo -F @project-minato/db db:push",
		"db:studio": "turbo -F @project-minato/db db:studio",
		"db:generate": "turbo -F @project-minato/db db:generate",
		"db:migrate": "turbo -F @project-minato/db db:migrate",
		"infra:up": "docker-compose -f docker-compose.dev.yaml up -d",
		"create-scraper": "bun run packages/create-minato-scraper/src/index.ts",
		"check": "biome check --write .",
		"nuke": "rm -rf node_modules && rm -rf packages/*/node_modules && rm -rf apps/*/node_modules && rm -rf apps/*/.next && rm -rf .turbo && rm -rf apps/*/dist && rm -rf packages/*/dist && rm bun.lock && bun install"
	},
	"dependencies": {
		"@project-minato/env": "workspace:*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@project-minato/typescript": "workspace:*",
		"@types/bun": "catalog:",
		"portless": "latest",
		"turbo": "^2.9.18",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.0",
	"patchedDependencies": {
		"release-parser@1.5.3": "patches/release-parser@1.5.3.patch"
	}
}
